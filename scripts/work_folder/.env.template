# scripts/work_folder/.env (template)

############################################
# 既存（SQLite import/apply 用）
############################################
APP_ENV=prod

############################################
# v1.0 固定（重要）
############################################
# - v1.0 現状: work_folder が参照するテーブルはすべて dev_phr スキーマに存在する前提
#   (staging_subscribers_hub/fund, templates, etl_runs/etl_errors, funds/fund_insurer_numbers など)
# - 実値入り .env は Git 管理しない。これはテンプレ。


FUND_TEMPLATE_VERSION=20250908
FUND_LOADER_BATCH=2000
FUND_LOADER_TRACE=1
FUND_LIMIT=0

############################################
# 新規（MySQL 用設定）
############################################
PHR_MYSQL_HOST=__FILE_ME__
PHR_MYSQL_PORT=3306
PHR_MYSQL_USER=__FILE_ME__
PHR_MYSQL_PASSWORD=__FILE_ME__
PHR_MYSQL_DB=dev_phr
# v1.0 現状: ここは dev_phr 固定（切替する場合は v2 で扱う）

############################################
# custom_id_gen: mat（対応表）
############################################
# v1.0: person_id_custom 生成は mat 配下の JSON（対応表）を参照する。
# 既定の探索先: <scripts/work_folder>/mat/
# - 必須: custom_id_config.json
# - 必須: custom_id_config.json 内で指定された mapping_file（0-9→任意文字の写像表）
#
# 運用メモ:
# - mat は「仕様そのもの」。変更＝ID仕様変更なので v1.0 中は触らない。
# - 参照パスを変える場合はスクリプト引数（例: --mat）で上書きする。
#
#CUSTOM_ID_MAT_DIR=scripts/work_folder/mat

# ===== fund import (dev default) =====
# ※このブロックは旧 fund_enrollee_loader 用（現行の subscribers_fund 取込とは別）
#FUND_IMPORT_INPUT=work_folder/fund_enrollee_loader/input
#FUND_IMPORT_INSURER=99999999
#FUND_IMPORT_BATCH=2000
#FUND_IMPORT_LIMIT=0
#FUND_IMPORT_LOGLEVEL=INFO

############################################
# fund subscribers import（今回のスクリプト用）
############################################

# v1.0: 入力構成
# - <FUND_SUBSCRIBERS_INPUT_BASE>/<active|past|error>/<insurer(8桁)>/*.csv
# - active 配下が処理対象（成功/失敗で past/error へ移動できる）

# 入力ベース（work_folder 相対）
# → <work_folder>/phr/input/subscribers_fund
FUND_SUBSCRIBERS_INPUT_BASE=phr/input/subscribers_fund

# active / past / error 構成
FUND_SUBSCRIBERS_ACTIVE_DIR=active
FUND_SUBSCRIBERS_PAST_DIR=past
FUND_SUBSCRIBERS_ERROR_DIR=error

# 成功・失敗時にファイル移動するか
FUND_SUBSCRIBERS_MOVE_ON_SUCCESS=1
FUND_SUBSCRIBERS_MOVE_ON_FAIL=1

############################################
# templates / template_mappings（fund 前提データ）
############################################
# v1.0: import_subscribers_to_staging_fund.py は DB 上の templates / template_mappings を前提とする。
# - 再現性のため、別途 seed SQL（INSERT）を Git 管理するのが推奨。
# - どの DB に入っているか（v1.0現状）: dev_phr.templates / dev_phr.template_mappings