# ==================================================
# 共通
# ==================================================
TZ=Asia/Tokyo
LOG_LEVEL=INFO

# ==================================================
# medi_import（医療機関 健診XML取込）
# ==================================================
MEDI_IMPORT_INPUT_ROOT=medi_input

MEDI_IMPORT_DB_HOST=__FILE_ME__
MEDI_IMPORT_DB_PORT=3306
MEDI_IMPORT_DB_NAME=work_other
MEDI_IMPORT_DB_USER=__FILE_ME__
MEDI_IMPORT_DB_PASSWORD=__FILE_ME__

MEDI_IMPORT_DRY_RUN=false

# ==================================================
# XMLフェーズ制御
# ==================================================


MEDI_IMPORT_MODE=FULL

# ZIP_IMPORT側
MEDI_IMPORT_XML_ENABLED=true
MEDI_IMPORT_XML_PARSE_WELLFORMED=false

# XML_EXTRACT側
MEDI_IMPORT_XML_TARGET_STATUS=PENDING
MEDI_IMPORT_XML_EXTRACT_LIMIT=999999


# ==================================================
# XSD（ZIP内ではなく、ローカル正規XSDを使う）
# ==================================================
MEDI_IMPORT_XSD_ROOT=XSD
MEDI_IMPORT_XSD_MAIN=hc08_V08.xsd

# ==================================================
# ZIP解凍のTMPフォルダ設定、長いパス対策
# 以下のフォルダなければ要自分で作成
# ==================================================
MEDI_IMPORT_TEMP_ROOT=C:/_medi_tmp

# ==================================================
# XML ITEM VALUE 抽出フェーズ
# ==================================================

# 抽出有効化（将来のON/OFF用。現状は参照用）
MEDI_IMPORT_XML_ITEM_EXTRACT_ENABLED=true

# 1回の実行で処理するXML件数
ITEM_EXTRACT_LIMIT=0

# item values 抽出用 run_id
# medi_import_runs に既存の run_id を指定（0でも可）
ITEM_EXTRACT_RUN_ID=0

# ==================================================
# dev_phr（健診項目マスタ参照用）
# ==================================================

PHR_MYSQL_HOST=__FILE_ME__
PHR_MYSQL_PORT=3306
PHR_MYSQL_DB=dev_phr
PHR_MYSQL_USER=__FILE_ME__
PHR_MYSQL_PASSWORD=__FILE_ME__

# ファイル内容SHA-256を計算して DB に埋める。
# 共有フォルダ（差分スキャン起点）
MEDI_SHARED_ROOT=__PATH_SCANDIR__

# スキャン対象拡張子（カンマ区切り）
MEDI_SHARED_SCAN_EXTS=zip

# 処理件数(任意: 0=無制限)
MEDI_SHARED_HASH_LIMIT=0

# コピー系
MEDI_SHARED_COPY_REQUIRE_XML=true
MEDI_SHARED_COPY_SKIP_IMPORTED=true

MEDI_SHARED_COPY_LIMIT=1000
MEDI_SHARED_COPY_OVERWRITE=false

# judge系
MEDI_SHARED_AUTO_LIMIT=0

MEDI_SHARED_AUTO_ONLY_STAGE=NEW

MEDI_SHARED_AUTO_ONLY_EXT=zip

# （デフォfalse）
MEDI_SHARED_AUTO_ADD_KEYWORD_NOTE=false


# 提出用CSVの配置ディレクトリ（scripts/ からの相対 or 絶対）
# 例：保険者番号 06139463 / symbol100
SUBMIT_INBOX_ROOT=submit_inbox/06139463/symbol100

# 取込先テーブル名（既に作成済みのもの）
SUBMIT_TARGET_TABLE=symbol100_all_20260127

# 取込前に TRUNCATE するか
SUBMIT_TRUNCATE=true

# ログレベル（普段は INFO、調査時に DEBUG）
LOG_LEVEL=DEBUG

# DB接続用
SUBMIT_DB_HOST=__FILE_ME__
SUBMIT_DB_PORT=3306
SUBMIT_DB_NAME=work_other
SUBMIT_DB_USER=__FILE_ME__
SUBMIT_DB_PASSWORD=__FILE_ME__

MYSQL_HOST=__FILE_ME__
MYSQL_PORT=3306
MYSQL_USER=__FILE_ME__
MYSQL_PASSWORD=__FILE_ME__

# ---- normalize_db_update jobs on/off 1=on 0=off ----
NORMALIZE_JOB_TARGETS_FIND_XML_SUBSCRIBERS_LIST_20260128=0
NORMALIZE_JOB_LEDGER_NAME_KANA_MATCH=0
NORMALIZE_JOB_FIND_INSURANCE_NUMBER_MATCH=0
NORMALIZE_JOB_FIND_INSURANCE_SYMBOL_MATCH=0
NORMALIZE_JOB_LEDGER_INSURANCE_NUMBER_MATCH=0
NORMALIZE_JOB_LEDGER_INSURANCE_SYMBOL_MATCH=0
NORMALIZE_JOB_TARGETS_NAME_KANA_MATCH=0



# ---- optional ----
# 1 = dry-run, 0 = 本実行（未設定なら0）
# dry-run（全体）
NORMALIZE_DRY_RUN=0

# --- medi_exam_result_ledger ---
NORMALIZE_JOB_EXAM_LEDGER_NAME_KANA_MATCH=1
NORMALIZE_JOB_EXAM_LEDGER_INSURANCE_CARD_NUMBER_MATCH=1
NORMALIZE_JOB_EXAM_LEDGER_INSURANCE_CARD_SYMBOL_MATCH=1





# runtime
NORM_DRY_RUN=0
NORM_LIMIT=2000
NORM_COMMIT_EVERY=500

# ★このテーブル定義に合わせる
NORM_TABLE_NAME=medi_exam_result_item_values
NORM_KEY_COL=item_value_id
NORM_NAMECODE_COL=namecode
NORM_RAW_COL=raw_value

NORM_STATUS_COL=normalize_status
NORM_ERROR_COL=normalize_error
NORM_VALUE_COL=value
NORM_UPDATED_COL=normalized_at

# ★RAWだけ対象（空NULLじゃないから）
NORM_ONLY_RAW=1

# master
MASTER_TABLE=exam_item_master
MASTER_NAMECODE_COL=namecode
MASTER_XMLTYPE_COL=xml_value_type
MASTER_RESULT_OID_COL=result_code_oid

# variants
VAR_TABLE=norm_variants
VAR_OID_COL=result_code_oid
VAR_TOKEN_COL=raw_token_norm
VAR_CODE_COL=normalized_code

# 出力先ルート（未設定なら {project}/medi_export_xml）
EXPORT_ROOT=__PATH_OUTPUT__

# XMLの作成日（未設定なら当日）
EXPORT_FILE_DATE=20260130

# 件数制限（未設定なら全件）
EXPORT_LIMIT=100

# IX08ファイル名
EXPORT_IX08_NAME=ix08.xml

# XMLエンコーディング
EXPORT_XML_ENCODING=utf-8

# 厚労省：同日分割送信回数(N) と 実施区分コード(X)
EXPORT_SPLIT_NO=0
EXPORT_IMPL_CODE=1

# 厚労省：個人XMLファイル種別（表2の「種別」=1桁）
# 特定健診データファイル → 1（必要に応じて変更）
EXPORT_FILE_KIND=1

# ルートフォルダ名テンプレ（空なら厚労省規則で自動生成）
EXPORT_GROUP_DIR_TEMPLATE=

# ZIP名テンプレ（空なら {root_dir}.zip）
EXPORT_ZIP_NAME_TEMPLATE=

