############################################
# v1.1.0 / MySQL接続設定（PHR共通）
# - host単位で管理
# - schemaは原則スクリプト側の既定値を使う
# - 管理画面など複数schemaを横断する処理は下記PHR_*_DBで明示する
# - 機微情報のため.gitignore対象
############################################
PHR_DB_HOST=__FILE_ME__
PHR_DB_PORT=3306
PHR_DB_USER=__FILE_ME__
PHR_DB_PASSWORD=__FILE_ME__

############################################
# schema名（通常はこのまま）
############################################
PHR_APP_DB=phr_app
PHR_HEALTH_DB=health_exam_result
PHR_MASTER_DB=phr_master
PHR_DEV_DB=dev_phr
PHR_WORK_DB=work_other

############################################
# 管理画面（FastAPI）
# - 既定は同一LAN内の別PCからアクセス可能な 0.0.0.0
# - 起動PCだけに閉じたい場合は PHR_ADMIN_HOST=127.0.0.1 にする
# - PHR_ADMIN_ALLOWED_CLIENT_IPS を設定すると、記載IP以外はログイン画面にも到達不可
# - IPは範囲指定ではなく個別指定
# - PHR_ADMIN_TRUST_PROXY_HEADERS はCaddy等の信頼済みプロキシ配下だけ1にする
############################################
PHR_ADMIN_HOST=0.0.0.0
PHR_ADMIN_ALLOWED_CLIENT_IPS=
PHR_ADMIN_TRUST_PROXY_HEADERS=0
